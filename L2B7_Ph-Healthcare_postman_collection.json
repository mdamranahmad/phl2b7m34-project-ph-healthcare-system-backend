{
	"info": {
		"_postman_id": "b0f8ab85-0703-4a05-83de-31aa8e2d6971",
		"name": "L2B7 Ph-Healthcare",
		"description": "Postman collection for the L2B7 Ph-Healthcare backend (Express + Prisma + Zod). Regenerated from the actual source code (routes, validation schemas, controllers) to keep paths, HTTP methods, request bodies, form-data fields and required roles accurate.\n\nAuth model: every protected route reads the access token from either the `accessToken` httpOnly cookie (set automatically by login/verify-email/refresh) or an `Authorization: Bearer <token>` header. This collection uses the Bearer header approach via the {{accessToken}} variable so it works even with the Postman cookie jar disabled.\n\nTypical flows:\n1. Patient: Register Patient -> Verify Email (captures accessToken) -> Book Appointment, etc.\n2. Doctor: Apply As Doctor -> Verify Doctor Email (captures doctorId) -> Admin: Approve Doctor -> Doctor: Credential Login (captures accessToken) -> Create/Publish Schedule.\n3. Admin/Super Admin accounts are seeded via environment variables (see `src/app/utils/seed.ts` / `.env`), not created via this API \u2014 log in with those credentials.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register Patient",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"register"
							]
						},
						"description": "Registers a new PATIENT account. Creates an unverified user, sends a 6-digit OTP to the given email and stores it in Redis. Call 'Verify Email' next with the same email and the OTP to activate the account and receive tokens.",
						"auth": {
							"type": "noauth"
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Samin Ravi\",\n    \"email\": \"{{patientEmail}}\",\n    \"password\": \"{{patientPassword}}\",\n    \"patient\": {\n        \"contactNumber\": \"+8801700000000\"\n    }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": []
				},
				{
					"name": "Verify Email",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/auth/verify-email",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"verify-email"
							]
						},
						"description": "Verifies the OTP sent during patient registration, marks the user as verified and logs them in. Response contains accessToken/refreshToken (also set as httpOnly cookies) which are auto-saved to the {{accessToken}}/{{refreshToken}} collection variables.",
						"auth": {
							"type": "noauth"
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{patientEmail}}\",\n    \"otp\": \"123456\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"",
									"if (res && res.data && res.data.accessToken) {",
									"    pm.collectionVariables.set(\"accessToken\", res.data.accessToken);",
									"    pm.collectionVariables.set(\"refreshToken\", res.data.refreshToken || \"\");",
									"}",
									"",
									"if (res && res.data && res.data.user && res.data.user.id) {",
									"    pm.collectionVariables.set(\"userId\", res.data.user.id);",
									"}"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					]
				},
