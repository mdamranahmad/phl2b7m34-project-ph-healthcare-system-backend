		});
	}

	const schedules = await prisma.schedule.findMany({
		where: {
			AND: andConditions,
		},

		take: limit,
		skip,
		orderBy: {
			// startDateTime: "desc"
			[sortBy]: sortOrder,
		},
		include: {
			appointments: {
