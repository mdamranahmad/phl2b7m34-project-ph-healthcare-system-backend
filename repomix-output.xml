<file path="prisma/schema/doctor.prisma">
model Doctor {
  id String @id @default(uuid())

  name    String
  email   String  @unique
  address String?

  specialization  String
  licenseNumber   String @unique
  qualifications  String
  experienceYears Int

  bio             String?
  consultationFee Decimal? @db.Decimal(10, 2)

  contactNumber String?

  verificationStatus DoctorVerificationStatus @default(PENDING)
  rejectionReason    String?
  reviewedBy         String?
  reviewedAt         DateTime?

  resume          String?
  resumePublicId  String?
  additionalFiles Json? //  stores: [{url: "...", publicId: "..."}]

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  shcedules    Schedule[]
  appointments Appointment[]

  @@index([email], name: "idx_doctor_email")
  @@map("doctors")
}
</file>

<file path="prisma/schema/patient.prisma">
model Patient {
  id String @id @default(uuid(7))

  name          String
  email         String    @unique
  contactNumber String?
  address       String?
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  //relations
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  appointments Appointment[]

  @@index([email], name: "idx_patient_email")
  @@index([isDeleted], name: "idx_patient_isDeleted")
  @@map("patients")
}
</file>

<file path="prisma/schema/payment.prisma">
model Payment {
  id String @id @default(uuid())

  status PaymentStatus @default(UNPAID)

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("BDT")

  paymentGateway        String @default("bkash")
  merchantInvoiceNumber String @unique // appointmentId

  bkashPaymentId String? @unique
  bkashTrxId     String?
  payerReference String? // user email | phone number
  paidAt         String?

  gatewayResponse Json? // The complete data from a payment response in bkash

  refundTrxId  String?
  refundAmount Decimal? @db.Decimal(10, 2)
  refundReason String?
  refundedAt   String?

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}
</file>

